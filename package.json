{
	"name": "dynamic-array",
	"version": "0.1.0",
	"description": "A high-performance, dynamically resizing wrapper around JavaScript TypedArrays",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"scripts": {
		"test": "bun test",
		"bench": "bun benchmarks/index.ts",
		"build": "bunup index.ts utils.ts --out-dir dist",
		"check": "biome check",
		"lint": "biome lint",
		"format": "biome format",
		"check:type": "bun x tsc --noEmit"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./utils": {
			"types": "./dist/utils.d.ts",
			"import": "./dist/utils.js",
			"default": "./dist/utils.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"typedarray",
		"dynamic-array",
		"performance",
		"memory-efficient",
		"webassembly",
		"webgpu",
		"arraybuffer",
		"buffer",
		"data-structures",
		"typescript"
	],
	"license": "MIT",
	"author": "",
	"repository": {
		"type": "git",
		"url": ""
	},
	"homepage": "",
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/bun": "^1.4.2",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"@webgpu/types": "^0.1.74",
		"bun-webgpu": "^0.1.7",
		"bunup": "^0.16.32",
		"mitata": "^1.0.34",
		"typed-numarray": "^1.0.9"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	}
}
